# ============================================================================
# Polymarket API Authentication (Choose ONE method below)
# ============================================================================

# OPTION 1: API Key-based Authentication
# Get these from: https://polymarket.com/settings/api
# (Only use if you have API keys from Polymarket settings)
POLYMARKET_API_KEY=your_api_key_here
POLYMARKET_PRIVATE_KEY=your_private_key_here

# OPTION 2: Wallet-based Authentication (Use if you login via Phantom wallet)
# Your wallet address (public address from Phantom)
POLYMARKET_WALLET_ADDRESS=your_wallet_address_here
# Funder address (usually same as wallet address, but can be different)
# Leave empty to use same as POLYMARKET_WALLET_ADDRESS
POLYMARKET_FUNDER_ADDRESS=your_funder_address_here
# Note: Private key is in PROXY_WALLET_PRIVATE_KEY below

# Optional: API Base URLs (usually don't need to change)
# POLYMARKET_CLOB=https://clob.polymarket.com
# POLYMARKET_GAMMA=https://gamma-api.polymarket.com

# ============================================================================
# Polymarket Builder API Credentials (for gasless merge/redeem)
# ============================================================================
# Get these from: https://polymarket.com/settings?tab=builder
# Create a Builder Profile and generate API keys in the "Builder Keys" section
POLY_BUILDER_API_KEY=your_builder_api_key_here
POLY_BUILDER_SECRET=your_builder_secret_here
POLY_BUILDER_PASSPHRASE=your_builder_passphrase_here

# ============================================================================
# Proxy Wallet Configuration (for gasless transactions)
# ============================================================================
# Your Phantom wallet private key (used for signing transactions)
# This wallet should hold USDC.e on Polygon network for trading
PROXY_WALLET_PRIVATE_KEY=your_phantom_wallet_private_key_here

# Polygon RPC endpoint (for blockchain interactions)
POLYGON_RPC_URL=https://polygon-rpc.com

# USDC.e contract address on Polygon (for balance checking)
# Default: 0x2791Bca1f2de4661ED88A30C99A7a9449Aa84174 (USDC.e - bridged version used by Polymarket)
# Alternative: 0x3c499c542cEF5E3811e1192ce70d8cC03d5c3359 (Native USDC on Polygon)
# Leave empty to use default USDC.e address
USDC_E_CONTRACT_ADDRESS=0x2791Bca1f2de4661ED88A30C99A7a9449Aa84174

